# ==========================================
# Google Gemini API (Free tier from https://aistudio.google.com/)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Meta WhatsApp Cloud API (Free test tier from https://developers.facebook.com/)
# ==========================================
WHATSAPP_TOKEN=your_meta_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WEBHOOK_VERIFY_TOKEN=clinic_bot_secret_verify_token_123

# ==========================================
# Clinic Owner WhatsApp Number (for instant booking alert)
# Format: country code + phone without '+' or spaces (e.g., 919876543210 for India)
# ==========================================
CLINIC_OWNER_PHONE=919876543210
CLINIC_NAME="Sharma Health Clinic"
DOCTOR_NAME="Dr. Sharma"
